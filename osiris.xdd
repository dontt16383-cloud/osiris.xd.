    task.wait(1)
    -- Базовые
    if OrbsEnabled then createOrbitOrbs() end
    if RingEnabled then createHaloRing() end
    if GroundEnabled then createGroundAura() end
    if FireEnabled then createFireAura() end
    if IceEnabled then createIceAura() end
    if BeamEnabled then createBeamAura() end
    if PetalsEnabled then createPetalsAura() end
    if TornadoEnabled then createTornadoAura() end
    if DarkMatterEnabled then createDarkMatter() end
    if LightningEnabled then createLightningAura() end
    if TrailEnabled then createRainbowTrail() end
    if ChinaHatEnabled then createChinaHat() end
    -- Новые 30
    if WingsEnabled then createWings() end
    if SwordsEnabled then createSwords() end
    if MatrixEnabled then createMatrix() end
    if VoidEnabled then createVoid() end
    if ShieldEnabled then createShield() end
    if CrystalsEnabled then createCrystals() end
    if HologramEnabled then createHologram() end
    if BooksEnabled then createBooks() end
    if CrownEnabled then createCrown() end
    if ButterfliesEnabled then createButterflies() end
    if SoulsEnabled then createSouls() end
    if GridEnabled then createGrid() end
    if BubblesEnabled then createBubbles() end
    if CageEnabled then createCage() end
    if RadioactiveEnabled then createRadioactive() end
    if CosmicEnabled then createCosmic() end
    if GalaxyEnabled then createGalaxy() end
    if BloodEnabled then createBlood() end
    if FeathersEnabled then createFeathers() end
    if RunesEnabled then createRunes() end
    if DaggersEnabled then createDaggers() end
    if ShockwaveEnabled then createShockwave() end
    if SmokeEnabled then createSmoke() end
    if PrismEnabled then createPrism() end
    if FlameWingsEnabled then createFlameWings() end
    if IceSpikesEnabled then createIceSpikes() end
    if ToxicEnabled then createToxic() end
