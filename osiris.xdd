EspGroup:CreateToggle({
    Name = "Enable ESP", CurrentValue = false,
    Callback = function(v)
        ESPEnabled = v
        if not v then
            for plr, d in pairs(PlayerData) do
                pcall(function()
                    if d.highlight then d.highlight:Destroy() end
                    if d.billboard then d.billboard:Destroy() end
                    for _, k in ipairs({"boxTop","boxBottom","boxLeft","boxRight","tracer"}) do
                        if d[k] then d[k]:Remove() end
                    end
                end)
                PlayerData[plr] = nil
