    if SupernovaEnabled then createSupernova() end
end)

-- ===================== COMBAT =====================
local MurderGroup = CombatTab:CreateGroupbox({ Name = "Murder", Column = 1, Icon = NebulaIcons:GetIcon('skull', 'Lucide') }, "MURDER_GROUP")
MurderGroup:CreateToggle({ Name = "Kill Aura", CurrentValue = false, Callback = function(v) KillAura = v end }, "COMBAT_KILLAURA")
MurderGroup:CreateSlider({ Name = "Aura Radius", Range = {8, 45}, Increment = 1, CurrentValue = 18, Callback = function(v) KillAuraRadius = v end }, "COMBAT_AURARAD")
MurderGroup:CreateToggle({ Name = "Auto Knife", CurrentValue = false, Callback = function(v) AutoKnife = v end }, "COMBAT_AUTOKNIFE")
MurderGroup:CreateToggle({ Name = "Auto Equip Knife", CurrentValue = false, Callback = function(v) AutoEquipKnife = v end }, "COMBAT_EQUIP")
MurderGroup:CreateToggle({ Name = "Face Target", CurrentValue = false, Callback = function(v) FaceTarget = v end }, "COMBAT_FACE")
MurderGroup:CreateToggle({ Name = "Kill All", CurrentValue = false, Callback = function(v) KillAll = v end }, "COMBAT_KILLALL")

local SheriffGroup = CombatTab:CreateGroupbox({ Name = "Sheriff", Column = 2, Icon = NebulaIcons:GetIcon('target', 'Lucide') }, "SHERIFF_GROUP")
SheriffGroup:CreateToggle({ Name = "Silent Aim", CurrentValue = false, Callback = function(v) GunSilentAim = v end }, "COMBAT_SILENT")
SheriffGroup:CreateSlider({ Name = "Smooth", Range = {5, 100}, Increment = 1, CurrentValue = 35, Callback = function(v) GunSmooth = v end }, "COMBAT_SMOOTH")
SheriffGroup:CreateToggle({ Name = "Triggerbot", CurrentValue = false, Callback = function(v) Triggerbot = v end }, "COMBAT_TRIGGER")
SheriffGroup:CreateToggle({ Name = "Auto Grab Gun", CurrentValue = false, Callback = function(v) AutoGrabGun = v end }, "COMBAT_GRAB")
SheriffGroup:CreateToggle({ Name = "Auto Kill Murderer", CurrentValue = false, Callback = function(v) AutoKillMurderer = v end }, "COMBAT_KILLMURD")

-- ===================== ЛОГИКА COMBAT & ESP =====================
local function getKnife()
    local char = LocalPlayer.Character; if not char then return nil end
    return char:FindFirstChild("Knife") or (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild("Knife"))
end
local function isMurderer(plr)
    if not plr.Character then return false end
    return plr.Character:FindFirstChild("Knife") or (plr:FindFirstChild("Backpack") and plr.Backpack:FindFirstChild("Knife"))
end

track(RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character; if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart"); local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    if AutoEquipKnife then
        local knife = getKnife()
        if knife and knife.Parent == LocalPlayer.Backpack then hum:EquipTool(knife) end
    end
    local knife = char:FindFirstChild("Knife")
    if not knife then return end
    if KillAura or KillAll then
        local radius = KillAll and 90 or KillAuraRadius
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local tRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                local tHum = plr.Character:FindFirstChildOfClass("Humanoid")
                if tRoot and tHum and tHum.Health > 0 and (tRoot.Position - root.Position).Magnitude <= radius then
                    if FaceTarget then root.CFrame = CFrame.lookAt(root.Position, tRoot.Position) end
                    knife:Activate()
                end
            end
        end
    end
    if AutoKnife then knife:Activate() end
end))

track(RunService.RenderStepped:Connect(function()
    if AutoGrabGun then
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj.Name == "Gun" and obj:IsA("Tool") then
                local handle = obj:FindFirstChild("Handle")
                local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if handle and myRoot and (handle.Position - myRoot.Position).Magnitude < 20 then obj.Parent = LocalPlayer.Backpack end
            end
        end
    end
    local gun = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Gun")
    if not gun or not (GunSilentAim or Triggerbot or AutoKillMurderer) then return end
    local target = nil
    if AutoKillMurderer then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and isMurderer(plr) then
                local tHum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
                if tHum and tHum.Health > 0 then target = plr; break end
            end
        end
    else
        local closest, closestDist = nil, 250
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myRoot then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    local tRoot = plr.Character:FindFirstChild("HumanoidRootPart"); local tHum = plr.Character:FindFirstChildOfClass("Humanoid")
                    if tRoot and tHum and tHum.Health > 0 then
                        local dist = (tRoot.Position - myRoot.Position).Magnitude
                        if dist < closestDist then closest = plr; closestDist = dist end
                    end
                end
            end
        end
        target = closest
    end
    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        local tp = target.Character.HumanoidRootPart.Position + Vector3.new(0, 2, 0)
        if GunSilentAim or AutoKillMurderer then
            local camCF = Camera.CFrame
            Camera.CFrame = camCF:Lerp(CFrame.new(camCF.Position, tp), math.clamp(GunSmooth / 100, 0.05, 1))
        end
        if Triggerbot or AutoKillMurderer then gun:Activate() end
    end
end))

local function getRole(plr)
    if not plr.Character then return "Dead" end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return "Dead" end
    local bp = plr:FindFirstChild("Backpack")
    if plr.Character:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife")) then return "Murderer" end
    if plr.Character:FindFirstChild("Gun") or (bp and bp:FindFirstChild("Gun")) then return "Sheriff" end
    return "Innocent"
end

local function buildLabel(plr, role, dist)
    local lines = {}
    if ShowName then table.insert(lines, plr.Name) end
    local info = {}
    if ShowRole then table.insert(info, "[" .. role .. "]") end
    if ShowDistance then table.insert(info, dist .. "m") end
    if #info > 0 then table.insert(lines, table.concat(info, " ")) end
    if #lines == 0 then return "" end
    return table.concat(lines, "\n")
end

local function clearESP(plr)
    local d = PlayerData[plr]; if not d then return end
    pcall(function()
        if d.highlight then d.highlight:Destroy() end
        if d.billboard then d.billboard:Destroy() end
        for _, k in ipairs({"boxTop","boxBottom","boxLeft","boxRight","tracer"}) do if d[k] then d[k]:Remove() end end
    end)
    PlayerData[plr] = nil
end

local hasDrawing = pcall(function() local d = Drawing.new("Line"); d:Remove() end)

local function createESP(char, root)
    local hl = Instance.new("Highlight")
    hl.FillTransparency = 0.5; hl.OutlineTransparency = 0.15; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; hl.Adornee = char; hl.Parent = char
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 170, 0, 58); bb.StudsOffset = Vector3.new(0, 3.4, 0); bb.AlwaysOnTop = true; bb.Adornee = root; bb.Parent = char
    local list = Instance.new("UIListLayout", bb); list.SortOrder = Enum.SortOrder.LayoutOrder; list.HorizontalAlignment = Enum.HorizontalAlignment.Center; list.Padding = UDim.new(0, 2)
    local hpBg = Instance.new("Frame", bb); hpBg.LayoutOrder = 1; hpBg.Size = UDim2.new(0.9, 0, 0, 8); hpBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30); hpBg.BorderSizePixel = 0; hpBg.Visible = false; Instance.new("UICorner", hpBg).CornerRadius = UDim.new(0, 3)
    local hpFill = Instance.new("Frame", hpBg); hpFill.Size = UDim2.new(1, 0, 1, 0); hpFill.BackgroundColor3 = Color3.fromRGB(50, 255, 100); hpFill.BorderSizePixel = 0; Instance.new("UICorner", hpFill).CornerRadius = UDim.new(0, 3)
    local lab = Instance.new("TextLabel", bb); lab.LayoutOrder = 2; lab.Size = UDim2.new(1, 0, 0, 42); lab.BackgroundTransparency = 1; lab.Font = Enum.Font.GothamBold; lab.TextSize = 13; lab.TextStrokeTransparency = 0.35
    local data = { highlight = hl, billboard = bb, label = lab, hpBg = hpBg, hpFill = hpFill }
    if hasDrawing then
        for _, k in ipairs({"boxTop","boxBottom","boxLeft","boxRight","tracer"}) do
            local line = Drawing.new("Line"); line.Thickness = 1; line.Visible = false; data[k] = line
        end
    end
    return data
end

track(RunService.RenderStepped:Connect(function()
    if not ESPEnabled then return end
    RainbowHue = (RainbowHue + 0.005) % 1
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character; local root = char and char:FindFirstChild("HumanoidRootPart"); local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not root or not hum or hum.Health <= 0 then clearESP(plr) else
                local role = getRole(plr); local color = RainbowEnabled and Color3.fromHSV(RainbowHue, 0.9, 1) or Colors[role]
                local dist = 0; local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"); if myRoot then dist = math.floor((root.Position - myRoot.Position).Magnitude) end
                local d = PlayerData[plr]
                if d and d.highlight and d.highlight.Parent ~= char then clearESP(plr); d = nil end
                if not d then PlayerData[plr] = createESP(char, root); d = PlayerData[plr] end
                if d.highlight then d.highlight.FillColor = color; d.highlight.OutlineColor = color end
                if d.label then d.label.Text = buildLabel(plr, role, dist); d.label.TextColor3 = color end
                if d.hpBg then
                    d.hpBg.Visible = HPBarEnabled
                    if HPBarEnabled then
                        local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                        d.hpFill.Size = UDim2.new(pct, 0, 1, 0); d.hpFill.BackgroundColor3 = Color3.fromRGB(math.floor(255 * (1 - pct)), math.floor(255 * pct), 60)
                    end
                end
                if d.boxTop then
                    if BoxESPEnabled then
                        local hs, hon = Camera:WorldToViewportPoint(root.Position + Vector3.new(0, 3, 0)); local fs, fon = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
                        if hon and fon then
                            local hh = math.abs(hs.Y - fs.Y); local ww = hh * 0.6; local cx = (hs.X + fs.X) / 2; local tp = math.min(hs.Y, fs.Y); local bt = math.max(hs.Y, fs.Y)
                            d.boxTop.From = Vector2.new(cx - ww/2, tp); d.boxTop.To = Vector2.new(cx + ww/2, tp); d.boxBottom.From = Vector2.new(cx - ww/2, bt); d.boxBottom.To = Vector2.new(cx + ww/2, bt)
                            d.boxLeft.From = Vector2.new(cx - ww/2, tp); d.boxLeft.To = Vector2.new(cx - ww/2, bt); d.boxRight.From = Vector2.new(cx + ww/2, tp); d.boxRight.To = Vector2.new(cx + ww/2, bt)
                            for _, k in ipairs({"boxTop","boxBottom","boxLeft","boxRight"}) do d[k].Color = color; d[k].Visible = true end
                        else for _, k in ipairs({"boxTop","boxBottom","boxLeft","boxRight"}) do d[k].Visible = false end end
                    else for _, k in ipairs({"boxTop","boxBottom","boxLeft","boxRight"}) do d[k].Visible = false end end
                end
                if d.tracer then
                    if TracerEnabled then
                        local scr, on = Camera:WorldToViewportPoint(root.Position)
                        if on then
                            d.tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y); d.tracer.To = Vector2.new(scr.X, scr.Y); d.tracer.Color = color; d.tracer.Thickness = 1; d.tracer.Visible = true
                        else d.tracer.Visible = false end
                    else d.tracer.Visible = false end
                end
            end
        end
    end
end))

Players.PlayerRemoving:Connect(clearESP)

safeNotify({
    Title = "osiris.xd",
    Content = "v8.2 успешно загружена со всеми 30 аурами!",
    Duration = 3,
})

