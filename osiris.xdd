-- ===================== ACCESSORIES =====================
local AccessoryGroup = VisualsTab:CreateGroupbox({ Name = "Accessories", Column = 1, Icon = NebulaIcons:GetIcon('glasses', 'Lucide') }, "ACCESSORY_GROUP")

local function clearAuraType(type)
    if AuraObjects[type] then
        for _, obj in ipairs(AuraObjects[type]) do
            if obj and obj.Parent then obj:Destroy() end
        end
        AuraObjects[type] = {}
    end
end

local function createChinaHat()
    clearAuraType("ChinaHat")
    local char = LocalPlayer.Character
    if not char then return end

    local hat = Instance.new("Part")  
    hat.Name = "ChinaHat"  
    hat.Size = Vector3.new(3, 3, 3)   
    hat.Material = Enum.Material.SmoothPlastic  
    hat.Color = Color3.fromRGB(255, 180, 0)  
    hat.Anchored = true  
    hat.CanCollide = false  
    hat.CanQuery = false  
    hat.Transparency = 0  
    hat.Parent = workspace  

    local mesh = Instance.new("SpecialMesh", hat)  
    mesh.MeshType = Enum.MeshType.FileMesh  
    mesh.MeshId = "rbxassetid://1033714"   
    mesh.Scale = Vector3.new(1.5, 1.5, 1.5)  

    table.insert(AuraObjects.ChinaHat, hat)
end

AccessoryGroup:CreateToggle({
    Name = "China Hat",
    CurrentValue = false,
    Callback = function(v)
        ChinaHatEnabled = v
        if v then createChinaHat() else clearAuraType("ChinaHat") end
    end,
}, "ACC_CHINA")

-- ===================== VISUAL AURA (Базовые) =====================
local VisualAuraGroup = VisualsTab:CreateGroupbox({ Name = "Visual Aura", Column = 1, Icon = NebulaIcons:GetIcon('sparkles', 'Lucide') }, "VISUAL_AURA_GROUP")

local function createOrbitOrbs()
    clearAuraType("Orbs")
    for i = 1, 5 do
        local orb = Instance.new("Part")
        orb.Shape = Enum.PartType.Ball
        orb.Size = Vector3.new(0.8, 0.8, 0.8)
        orb.Material = Enum.Material.Neon
        orb.Anchored = true; orb.CanCollide = false; orb.Parent = workspace
        local light = Instance.new("PointLight", orb); light.Range = 6; light.Brightness = 2
        table.insert(AuraObjects.Orbs, orb)
    end
end

local function createHaloRing()
    clearAuraType("Ring")
    for i = 1, 12 do
        local part = Instance.new("Part")
        part.Shape = Enum.PartType.Ball
        part.Size = Vector3.new(0.4, 0.4, 0.4)
        part.Material = Enum.Material.Neon
        part.Anchored = true; part.CanCollide = false; part.Parent = workspace
        table.insert(AuraObjects.Ring, part)
    end
end

local function createGroundAura()
    clearAuraType("Ground")
    local disk = Instance.new("Part")
    disk.Shape = Enum.PartType.Cylinder; disk.Size = Vector3.new(0.2, 8, 8)
    disk.Material = Enum.Material.Neon; disk.Transparency = 0.5
    disk.Anchored = true; disk.CanCollide = false; disk.Parent = workspace
    table.insert(AuraObjects.Ground, disk)
    local emitter = Instance.new("ParticleEmitter", disk)
    emitter.Texture = "rbxassetid://243660364"; emitter.Color = ColorSequence.new(Color3.fromRGB(0, 255, 255))
    emitter.Rate = 20; emitter.Speed = NumberRange.new(1, 3); emitter.EmissionDirection = Enum.NormalId.Top
end

local function createFireAura()
    clearAuraType("Fire")
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local attach = Instance.new("Attachment", root)
    local emitter = Instance.new("ParticleEmitter", attach)
    emitter.Texture = "rbxassetid://243660364"; emitter.Color = ColorSequence.new(Color3.fromRGB(255, 100, 0), Color3.fromRGB(255, 0, 0))
    emitter.Size = NumberSequence.new(2, 4); emitter.Rate = 100; emitter.EmissionDirection = Enum.NormalId.Top
    table.insert(AuraObjects.Fire, attach)
end

local function createIceAura()
    clearAuraType("Ice")
    for i = 1, 6 do
        local shard = Instance.new("Part")
        shard.Shape = Enum.PartType.Block; shard.Size = Vector3.new(0.2, 2, 0.2)
        shard.Material = Enum.Material.Neon; shard.Color = Color3.fromRGB(150, 240, 255)
        shard.Anchored = true; shard.CanCollide = false; shard.Parent = workspace
        table.insert(AuraObjects.Ice, shard)
    end
end

local function createBeamAura()
    clearAuraType("Beam")
    local beam = Instance.new("Part")
    beam.Shape = Enum.PartType.Cylinder; beam.Size = Vector3.new(60, 2, 2)
    beam.Material = Enum.Material.Neon; beam.Color = Color3.fromRGB(100, 200, 255)
    beam.Transparency = 0.5; beam.Anchored = true; beam.CanCollide = false; beam.Parent = workspace
    table.insert(AuraObjects.Beam, beam)
end

local function createPetalsAura()
    clearAuraType("Petals")
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local attach = Instance.new("Attachment", root)
    local emitter = Instance.new("ParticleEmitter", attach)
    emitter.Texture = "rbxassetid://243660364"; emitter.Color = ColorSequence.new(Color3.fromRGB(255, 105, 180))
    emitter.Size = NumberSequence.new(0.5, 1.5); emitter.Rate = 40
    emitter.SpreadAngle = Vector2.new(180, 180); emitter.Acceleration = Vector3.new(0, -2, 0)
    table.insert(AuraObjects.Petals, attach)
end

local function createTornadoAura()
    clearAuraType("Tornado")
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local part = Instance.new("Part")
    part.Size = Vector3.new(1, 10, 1); part.Transparency = 1
    part.Anchored = true; part.CanCollide = false; part.Parent = workspace
    local emitter = Instance.new("ParticleEmitter", part)
    emitter.Texture = "rbxassetid://243660364"; emitter.Color = ColorSequence.new(Color3.fromRGB(200, 200, 200))
    emitter.Size = NumberSequence.new(1, 3); emitter.Rate = 100; emitter.Speed = NumberRange.new(10, 20)
    emitter.SpreadAngle = Vector2.new(10, 10); emitter.RotSpeed = NumberRange.new(360, 720)
    table.insert(AuraObjects.Tornado, part)
end

local function createDarkMatter()
    clearAuraType("DarkMatter")
    for i = 1, 6 do
        local orb = Instance.new("Part")
        orb.Shape = Enum.PartType.Ball; orb.Size = Vector3.new(0.7, 0.7, 0.7)
        orb.Material = Enum.Material.Neon; orb.Color = Color3.fromRGB(75, 0, 130)
        orb.Anchored = true; orb.CanCollide = false; orb.Parent = workspace
        local light = Instance.new("PointLight", orb); light.Color = Color3.fromRGB(150, 0, 255); light.Range = 4; light.Brightness = 2
        table.insert(AuraObjects.DarkMatter, orb)
    end
end

local function createLightningAura()
    clearAuraType("Lightning")
    for i = 1, 3 do
        local spark = Instance.new("Part")
        spark.Shape = Enum.PartType.Ball; spark.Size = Vector3.new(0.5, 0.5, 0.5)
        spark.Material = Enum.Material.Neon; spark.Color = Color3.fromRGB(255, 255, 0)
        spark.Anchored = true; spark.CanCollide = false; spark.Parent = workspace
        table.insert(AuraObjects.Lightning, spark)
    end
end

local function createRainbowTrail()
    clearAuraType("Trail")
    local char = LocalPlayer.Character
    if not char then return end
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if not torso then return end

    local att1 = Instance.new("Attachment", torso); att1.Position = Vector3.new(0, 1, 1)  
    local att2 = Instance.new("Attachment", torso); att2.Position = Vector3.new(0, -1, 1)  
    local trail = Instance.new("Trail", torso)  
    trail.Attachment0 = att1; trail.Attachment1 = att2  
    trail.Lifetime = 1  
    trail.Color = ColorSequence.new{  
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),  
        ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 255, 0)),  
        ColorSequenceKeypoint.new(0.4, Color3.fromRGB(0, 255, 0)),  
        ColorSequenceKeypoint.new(0.6, Color3.fromRGB(0, 255, 255)),  
        ColorSequenceKeypoint.new(0.8, Color3.fromRGB(0, 0, 255)),  
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 255))  
    }  
    table.insert(AuraObjects.Trail, att1); table.insert(AuraObjects.Trail, att2); table.insert(AuraObjects.Trail, trail)
end

