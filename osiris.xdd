-- Безопасная функция уведомлений
local function safeNotify(data)
    pcall(function()
        if Starlight and typeof(Starlight.Notify) == "function" then
            Starlight:Notify(data)
        else
            print("[osiris.xd] " .. tostring(data.Title) .. " - " .. tostring(data.Content))
        end
    end)
end

