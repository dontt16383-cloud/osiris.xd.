ExtraAuraGroup:CreateToggle({ Name = "Floating Daggers", CurrentValue = false, Callback = function(v) DaggersEnabled = v; if v then createDaggers() else clearAuraType("Daggers") end end }, "EXTRA_DAGGERS")
ExtraAuraGroup:CreateToggle({ Name = "Shockwave Rings", CurrentValue = false, Callback = function(v) ShockwaveEnabled = v; if v then createShockwave() else clearAuraType("Shockwave") end end }, "EXTRA_SHOCKWAVE")
ExtraAuraGroup:CreateToggle({ Name = "Ghostly Smoke", CurrentValue = false, Callback = function(v) SmokeEnabled = v; if v then createSmoke() else clearAuraType("Smoke") end end }, "EXTRA_SMOKE")
ExtraAuraGroup:CreateToggle({ Name = "Prism Shards", CurrentValue = false, Callback = function(v) PrismEnabled = v; if v then createPrism() else clearAuraType("Prism") end end }, "EXTRA_PRISM")
ExtraAuraGroup:CreateToggle({ Name = "Flame Wings", CurrentValue = false, Callback = function(v) FlameWingsEnabled = v; if v then createFlameWings() else clearAuraType("FlameWings") end end }, "EXTRA_FLAMEWINGS")
ExtraAuraGroup:CreateToggle({ Name = "Ice Spikes", CurrentValue = false, Callback = function(v) IceSpikesEnabled = v; if v then createIceSpikes() else clearAuraType("IceSpikes") end end }, "EXTRA_ICESPIKES")
ExtraAuraGroup:CreateToggle({ Name = "Toxic Slime", CurrentValue = false, Callback = function(v) ToxicEnabled = v; if v then createToxic() else clearAuraType("Toxic") end end }, "EXTRA_TOXIC")
ExtraAuraGroup:CreateToggle({ Name = "Shadow Swarm", CurrentValue = false, Callback = function(v) ShadowsEnabled = v; if v then createShadows() else clearAuraType("Shadows") end end }, "EXTRA_SHADOWS")
ExtraAuraGroup:CreateToggle({ Name = "Starry Canopy", CurrentValue = false, Callback = function(v) StarsEnabled = v; if v then createStars() else clearAuraType("Stars") end end }, "EXTRA_STARS")
ExtraAuraGroup:CreateToggle({ Name = "Supernova Pulse", CurrentValue = false, Callback = function(v) SupernovaEnabled = v; if v then createSupernova() else clearAuraType("Supernova") end end }, "EXTRA_SUPERNOVA")


-- ЕДИНЫЙ ЦИКЛ ОБНОВЛЕНИЯ ВСЕХ АУР
local auraAngle = 0
track(RunService.RenderStepped:Connect(function(dt)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    if not root then return end

    auraAngle = auraAngle + dt  

    -- Базовые ауры обновление
    if ChinaHatEnabled and head then  
        local hat = AuraObjects.ChinaHat[1]  
        if hat and hat.Parent then  
            local yOffset = 1.2 + math.sin(auraAngle * 2) * 0.05  
            local rotOffset = math.sin(auraAngle) * 5  
            hat.CFrame = CFrame.new(head.Position + Vector3.new(0, yOffset, 0)) * CFrame.Angles(0, math.rad(rotOffset), 0)  
        end  
    end  

    if OrbsEnabled then  
        for i, orb in ipairs(AuraObjects.Orbs) do  
            if orb and orb.Parent then  
                local a = auraAngle * 2 + (i-1) * (math.pi * 2 / 5)  
                orb.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a) * 4, math.sin(auraAngle * 2 + i) * 1.5, math.sin(a) * 4))  
                local hue = (a / (math.pi * 2)) % 1  
                orb.Color = Color3.fromHSV(hue, 0.8, 1)  
                if orb:FindFirstChild("PointLight") then orb.PointLight.Color = orb.Color end  
            end  
        end  
    end  

    if RingEnabled and head then  
        local basePos = head.Position + Vector3.new(0, 2.5, 0)  
        for i, part in ipairs(AuraObjects.Ring) do  
            if part and part.Parent then  
                local a = auraAngle * 3 + (i-1) * (math.pi * 2 / 12)  
                part.CFrame = CFrame.new(basePos + Vector3.new(math.cos(a) * 2.5, 0, math.sin(a) * 2.5))  
            end  
        end  
    end  

    if GroundEnabled then  
        for _, disk in ipairs(AuraObjects.Ground) do  
            if disk and disk.Parent then  
                disk.CFrame = CFrame.new(root.Position + Vector3.new(0, -2.8, 0)) * CFrame.Angles(math.rad(90), 0, 0) * CFrame.Angles(0, auraAngle, 0)  
            end  
        end  
    end  

    if IceEnabled then  
        for i, shard in ipairs(AuraObjects.Ice) do  
            if shard and shard.Parent then  
                local a = auraAngle * 1.5 + (i-1) * (math.pi * 2 / 6)  
                shard.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a) * 3, math.sin(auraAngle*3 + i)*0.5, math.sin(a) * 3)) * CFrame.Angles(0, a, math.rad(20))  
            end  
        end  
    end  

    if BeamEnabled then  
        for _, beam in ipairs(AuraObjects.Beam) do  
            if beam and beam.Parent then  
                beam.CFrame = CFrame.new(root.Position + Vector3.new(0, 28, 0)) * CFrame.Angles(0, 0, math.rad(90))  
            end  
        end  
    end  

    if TornadoEnabled then  
        for _, part in ipairs(AuraObjects.Tornado) do  
            if part and part.Parent then  
                part.CFrame = CFrame.new(root.Position + Vector3.new(0, 2, 0)) * CFrame.Angles(0, auraAngle * 5, 0)  
            end  
        end  
    end  

    if DarkMatterEnabled then  
        for i, orb in ipairs(AuraObjects.DarkMatter) do  
            if orb and orb.Parent then  
                local a = -auraAngle * 4 + (i-1) * (math.pi * 2 / 6)  
                orb.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a) * 3.5, math.sin(auraAngle * 3 + i) * 2, math.sin(a) * 3.5))  
            end  
        end  
    end  

    if LightningEnabled then  
        for _, spark in ipairs(AuraObjects.Lightning) do  
            if spark and spark.Parent then  
                if math.random() > 0.9 then  
                    local offset = Vector3.new(math.random(-4,4), math.random(0,5), math.random(-4,4))  
                    spark.CFrame = CFrame.new(root.Position + offset)  
                end  
            end  
        end  
    end

    -- Обновление 30 новых аур
    if WingsEnabled then
        for i, wp in ipairs(AuraObjects.Wings) do
            if wp and wp.Parent then
                local side = i <= 4 and -1 or 1
                local offset = Vector3.new(side * (1.2 + (i%4)*0.4), math.sin(auraAngle*3 + i)*0.3, -0.5)
                wp.CFrame = root.CFrame * CFrame.new(offset) * CFrame.Angles(0, 0, side * math.rad(30))
            end
        end
    end

    if SwordsEnabled then
        for i, sw in ipairs(AuraObjects.Swords) do
            if sw and sw.Parent then
                local a = auraAngle * 4 + (i-1)*(math.pi/2)
                sw.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a)*3, 2, math.sin(a)*3)) * CFrame.Angles(0, -a, math.rad(45))
            end
        end
    end

    if MatrixEnabled then
        for i, m in ipairs(AuraObjects.Matrix) do
            if m and m.Parent then
                local pos = root.Position + Vector3.new(math.sin(i + auraAngle*2)*3, (i*0.8 - 3 + auraAngle*5)%6 - 3, math.cos(i + auraAngle*2)*3)
                m.CFrame = CFrame.new(pos)
            end
        end
    end

    if VoidEnabled then
        for _, v in ipairs(AuraObjects.Void) do
            if v and v.Parent then
                local s = 4 + math.sin(auraAngle*2)*1
                v.Size = Vector3.new(s, s, s)
                v.CFrame = root.CFrame
            end
        end
    end

    if ShieldEnabled then
        for _, s in ipairs(AuraObjects.Shield) do
            if s and s.Parent then
                s.CFrame = root.CFream or root.CFrame
            end
        end
    end

    if CrystalsEnabled then
        for i, cr in ipairs(AuraObjects.Crystals) do
            if cr and cr.Parent then
                local a = auraAngle * 2 + (i-1)*(math.pi/3)
                cr.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a)*2.5, math.sin(auraAngle*3 + i)*1, math.sin(a)*2.5)) * CFrame.Angles(auraAngle, auraAngle, 0)
            end
        end
    end

    if HologramEnabled then
        for _, h in ipairs(AuraObjects.Hologram) do
            if h and h.Parent then
                local y = math.sin(auraAngle*3) * 2
                h.CFrame = CFrame.new(root.Position + Vector3.new(0, y, 0)) * CFrame.Angles(math.rad(90), 0, 0)
            end
        end
    end

    if BooksEnabled then
        for i, bk in ipairs(AuraObjects.Books) do
            if bk and bk.Parent then
                local a = auraAngle * 1.5 + (i-1)*(math.pi*2/3)
                bk.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a)*3, 1 + math.sin(auraAngle*2 + i)*0.5, math.sin(a)*3)) * CFrame.Angles(0, -a, math.rad(15))
            end
        end
    end

    if CrownEnabled and head then
        for _, crn in ipairs(AuraObjects.Crown) do
            if crn and crn.Parent then
                crn.CFrame = CFrame.new(head.Position + Vector3.new(0, 1.3, 0)) * CFrame.Angles(0, auraAngle, 0)
            end
        end
    end

    if ButterfliesEnabled then
        for i, b in ipairs(AuraObjects.Butterflies) do
            if b and b.Parent then
                local a = auraAngle * 3 + i
                b.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a)*2.5, math.sin(auraAngle*4 + i)*1.5, math.sin(a)*2.5)) * CFrame.Angles(0, a, math.sin(auraAngle*10)*0.5)
            end
        end
    end

    if SoulsEnabled then
        for i, s in ipairs(AuraObjects.Souls) do
            if s and s.Parent then
                local a = auraAngle + (i-1)*(math.pi*2/5)
                s.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a)*2, math.sin(auraAngle*2 + i)*2, math.sin(a)*2))
            end
        end
    end

    if GridEnabled then
        for _, g in ipairs(AuraObjects.Grid) do
            if g and g.Parent then
                g.CFrame = CFrame.new(root.Position + Vector3.new(0, -2.8, 0)) * CFrame.Angles(0, auraAngle, 0)
            end
        end
    end

    if BubblesEnabled then
        for i, bub in ipairs(AuraObjects.Bubbles) do
            if bub and bub.Parent then
                local a = auraAngle + i
                bub.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a)*2, (math.sin(auraAngle*2 + i)+1)*2, math.sin(a)*2))
            end
        end
    end

    if CageEnabled then
        for i, c in ipairs(AuraObjects.Cage) do
            if c and c.Parent then
                local a = (i-1)*(math.pi*2/6) + auraAngle
                c.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a)*3, 0, math.sin(a)*3))
            end
        end
    end

    if RadioactiveEnabled then
        for i, r in ipairs(AuraObjects.Radioactive) do
            if r and r.Parent then
                r.CFrame = CFrame.new(root.Position + Vector3.new(0, -2.5 + i*0.2, 0)) * CFrame.Angles(0, auraAngle * (i%2==0 and 2 or -2), 0)
            end
        end
    end

    if CosmicEnabled then
        for i, st in ipairs(AuraObjects.Cosmic) do
            if st and st.Parent then
                local a = auraAngle * 2 + i
                st.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a)*3.5, math.sin(i*2 + auraAngle)*2, math.sin(a)*3.5))
            end
        end
    end

    if GalaxyEnabled then
        for i, gal in ipairs(AuraObjects.Galaxy) do
            if gal and gal.Parent then
                local a = auraAngle * 3 + (i-1)*(math.pi*2/10)
                gal.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a)*4, math.sin(auraAngle)*0.5, math.sin(a)*4)) * CFrame.Angles(0, a, math.rad(45))
            end
        end
    end

    if BloodEnabled then
        for i, bl in ipairs(AuraObjects.Blood) do
            if bl and bl.Parent then
                local a = auraAngle * 2 + i
                bl.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a)*2, math.abs(math.sin(auraAngle*5 + i))*3, math.sin(a)*2))
            end
        end
    end

    if FeathersEnabled then
        for i, f in ipairs(AuraObjects.Feathers) do
            if f and f.Parent then
                local a = auraAngle + i
                f.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a)*2.5, 3 - ((auraAngle*3 + i*0.5)%5), math.sin(a)*2.5)) * CFrame.Angles(auraAngle, a, 0)
            end
        end
    end

    if RunesEnabled then
        for i, r in ipairs(AuraObjects.Runes) do
            if r and r.Parent then
                local a = (i-1)*(math.pi/2) - auraAngle
                r.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a)*3, -2.7, math.sin(a)*3)) * CFrame.Angles(0, a, 0)
            end
        end
    end

    if DaggersEnabled then
        for i, dag in ipairs(AuraObjects.Daggers) do
            if dag and dag.Parent then
                local a = auraAngle * 4 + (i-1)*(math.pi*2/6)
                dag.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a)*3.5, 1, math.sin(a)*3.5)) * CFrame.Angles(0, -a, math.rad(90))
            end
        end
    end

    if ShockwaveEnabled then
        for i, sw in ipairs(AuraObjects.Shockwave) do
            if sw and sw.Parent then
                local scale = ((auraAngle * 3 + i * 1.5) % 5) * 2
                sw.Size = Vector3.new(0.1, scale, scale)
                sw.CFrame = CFrame.new(root.Position + Vector3.new(0, -2.7, 0)) * CFrame.Angles(math.rad(90), 0, 0)
            end
        end
    end

    if SmokeEnabled then
        for i, sm in ipairs(AuraObjects.Smoke) do
            if sm and sm.Parent then
                local a = auraAngle + i
                sm.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a)*1.5, (auraAngle*2 + i)%4, math.sin(a)*1.5))
            end
        end
    end

    if PrismEnabled then
        for i, pr in ipairs(AuraObjects.Prism) do
            if pr and pr.Parent then
                local a = auraAngle * 2 + (i-1)*(math.pi*2/5)
                pr.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a)*3, math.sin(auraAngle*3)*1, math.sin(a)*3)) * CFrame.Angles(auraAngle, auraAngle, auraAngle)
            end
        end
    end

    if FlameWingsEnabled then
        for i, fw in ipairs(AuraObjects.FlameWings) do
            if fw and fw.Parent then
                local side = i <= 5 and -1 or 1
                fw.CFrame = root.CFrame * CFrame.new(side * (1 + (i%5)*0.3), math.sin(auraAngle*4)*0.2, -0.3) * CFrame.Angles(0, 0, side * math.rad(45))
            end
        end
    end

    if IceSpikesEnabled then
        for i, is in ipairs(AuraObjects.IceSpikes) do
            if is and is.Parent then
                local a = (i-1)*(math.pi*2/6)
                is.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a)*3, -2 + math.sin(auraAngle*4 + i)*0.5, math.sin(a)*3)) * CFrame.Angles(0, a, 0)
            end
        end
    end

    if ToxicEnabled then
        for i, tx in ipairs(AuraObjects.Toxic) do
            if tx and tx.Parent then
                local a = auraAngle * 3 + i
                tx.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a)*2, math.sin(auraAngle*4 + i)*1, math.sin(a)*2))
            end
        end
    end

    if ShadowsEnabled then
        for i, sh in ipairs(AuraObjects.Shadows) do
            if sh and sh.Parent then
                local a = -auraAngle * 2 + (i-1)*(math.pi*2/6)
                sh.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a)*3, 0.5, math.sin(a)*3))
            end
        end
    end

    if StarsEnabled and head then
        for i, st in ipairs(AuraObjects.Stars) do
            if st and st.Parent then
                local a = auraAngle * 2 + (i-1)*(math.pi*2/8)
                st.CFrame = CFrame.new(head.Position + Vector3.new(math.cos(a)*2, 2.5, math.sin(a)*2))
            end
        end
    end

    if SupernovaEnabled then
        for _, sn in ipairs(AuraObjects.Supernova) do
            if sn and sn.Parent then
                local p = 3 + math.sin(auraAngle * 6) * 0.8
                sn.Size = Vector3.new(p, p, p)
                sn.CFrame = root.CFrame
            end
        end
    end
end))

-- Перезапуск аур при респавне
