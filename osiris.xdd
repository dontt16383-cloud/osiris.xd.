-- ===================== FLING =====================
local FlingGroup = FlingTab:CreateGroupbox({ Name = "Touch Fling", Column = 1, Icon = NebulaIcons:GetIcon('wind', 'Lucide') }, "FLING_GROUP")

local function stopFling()
    if FlingConnection then FlingConnection:Disconnect(); FlingConnection = nil end
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local bav = hrp:FindFirstChild("FlingVelocity")
            if bav then bav:Destroy() end
        end
    end
end

local function startFling()
    stopFling()
    FlingConnection = RunService.Heartbeat:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local bav = hrp:FindFirstChild("FlingVelocity")
            if not bav then
                bav = Instance.new("BodyAngularVelocity")
                bav.Name = "FlingVelocity"
                bav.Parent = hrp
            end
            bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bav.AngularVelocity = Vector3.new(0, 999999, 0)

            for _, plr in ipairs(Players:GetPlayers()) do  
                if plr ~= LocalPlayer and plr.Character then  
                    local thrp = plr.Character:FindFirstChild("HumanoidRootPart")  
                    if thrp and (hrp.Position - thrp.Position).Magnitude < 5 then  
                        pcall(function()  
                            firetouchinterest(hrp, thrp, 0)  
                            firetouchinterest(hrp, thrp, 1)  
                        end)  
                    end  
                end  
            end  
        end  
    end)
end

FlingGroup:CreateToggle({
    Name = "Enable Touch Fling (Spin)",
    CurrentValue = false,
    Callback = function(v)
        FlingEnabled = v
        if v then startFling() else stopFling() end
    end,
}, "FLING_TOGGLE")

FlingGroup:CreateButton({
    Name = "Clear Fling",
    Icon = NebulaIcons:GetIcon('x', 'Lucide'),
    Callback = function()
        FlingEnabled = false
        stopFling()
        safeNotify({ Title = "Fling", Content = "Touch Fling отключен", Duration = 3 })
    end
}, "FLING_CLEAR")

local PlayerListGroup = FlingTab:CreateGroupbox({ Name = "Players in Server", Column = 1, Icon = NebulaIcons:GetIcon('users', 'Lucide') }, "PLAYER_LIST_GROUP")

local function flingTarget(target)
    if not target or not target.Character then return end
    local hrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    safeNotify({ Title = "Fling", Content = "Флингим " .. target.Name .. "!", Duration = 2 })  
      
    for _, v in ipairs(target.Character:GetDescendants()) do  
        if v:IsA("JointInstance") then v:Destroy() end  
    end  
      
    local bv = Instance.new("BodyVelocity")  
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)  
    bv.Velocity = Vector3.new(10000, 10000, 10000)  
    bv.Parent = hrp  
      
    hrp.Velocity = Vector3.new(10000, 10000, 10000)  
    hrp.CFrame = hrp.CFrame + Vector3.new(0, 50, 0)  
      
    task.wait(0.5)  
    if bv then bv:Destroy() end
end

local function refreshFlingPlayerList()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            PlayerListGroup:CreateButton({
                Name = "Fling: " .. plr.Name,
                Icon = NebulaIcons:GetIcon('crosshair', 'Lucide'),
                Callback = function()
                    flingTarget(plr)
                end
            }, "FLING_BTN" .. plr.UserId)
        end
    end
end

refreshFlingPlayerList()
Players.PlayerAdded:Connect(function(plr)
    if plr ~= LocalPlayer then
        PlayerListGroup:CreateButton({
            Name = "Fling: " .. plr.Name,
            Icon = NebulaIcons:GetIcon('crosshair', 'Lucide'),
            Callback = function()
                flingTarget(plr)
            end
        }, "FLING_BTN_" .. plr.UserId)
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    if FlingEnabled then startFling() end
end)

-- ===================== TROLL (ANIMATION TOOL + PLAYERS) =====================
getgenv().JERK_OFF_SPEED = getgenv().JERK_OFF_SPEED or 2
getgenv().KEEP_ON_DEATH = getgenv().KEEP_ON_DEATH ~= false and true or false

local TrollToolGroup = TrollTab:CreateGroupbox({ Name = "Custom Animation (R6 & R15)", Column = 1, Icon = NebulaIcons:GetIcon('smile', 'Lucide') }, "TROLL_TOOL_GROUP")

TrollToolGroup:CreateSlider({
    Name = "Animation Speed",
    Range = {0.5, 10},
    Increment = 0.5,
    CurrentValue = getgenv().JERK_OFF_SPEED,
    Callback = function(v)
        getgenv().JERK_OFF_SPEED = v
    end
}, "JERK_SPEED")

TrollToolGroup:CreateToggle({
    Name = "Keep on Death",
    CurrentValue = getgenv().KEEP_ON_DEATH,
    Callback = function(v)
        getgenv().KEEP_ON_DEATH = v
    end
}, "JERK_KEEP_DEATH")

local function setupJerkTool()
    if getgenv().JerkOffExecuted then
        safeNotify({ Title = "Troll", Content = "Инструмент уже активирован!", Duration = 2 })
        return
    end

    local Character = LocalPlayer.Character
    if not Character or (not Character:FindFirstChild("Torso") and not Character:FindFirstChild("UpperTorso")) then
        safeNotify({ Title = "Ошибка", Content = "Требуется персонаж (R6 или R15)!", Duration = 3 })
        return
    end

    getgenv().JerkOffExecuted = true
    local Humanoid = Character:WaitForChild("Humanoid", 1)

    local MAIN_ANIMATIONS = {
        JERK_OFF = "rbxassetid://99198989",
        CLOSER_HANDS = "rbxassetid://168086975",
    }

    local JerkingOff = false
    local JerkTool = Instance.new("Tool")
    JerkTool.Name = "Jerk Off"
    JerkTool.RequiresHandle = false
    JerkTool.Parent = game:GetService("ReplicatedStorage")

    LocalPlayer.CharacterAdded:Connect(function(newChar)
        Character = newChar
        Humanoid = Character:WaitForChild("Humanoid", 1)

        if getgenv().KEEP_ON_DEATH then
            local new_tool = JerkTool:Clone()
            new_tool.Parent = LocalPlayer.Backpack
            new_tool.Equipped:Connect(function() JerkingOff = true end)
            new_tool.Unequipped:Connect(function() JerkingOff = false end)
        end

        Humanoid.Died:Connect(function()
            JerkingOff = false
            if not getgenv().KEEP_ON_DEATH then
                getgenv().JerkOffExecuted = false
            end
        end)
    end)

    local new_tool = JerkTool:Clone()
    new_tool.Parent = LocalPlayer.Backpack
    new_tool.Equipped:Connect(function() JerkingOff = true end)
    new_tool.Unequipped:Connect(function() JerkingOff = false end)

    Humanoid.Died:Connect(function()
        JerkingOff = false
        if not getgenv().KEEP_ON_DEATH then
            getgenv().JerkOffExecuted = false
        end
    end)

    local jerkoffTrack, closerhandsTrack
    local setToOriginalValues = true

    track(RunService.RenderStepped:Connect(function()
        if not Humanoid then return end
        local currentSpeed = getgenv().JERK_OFF_SPEED or 2

        if JerkingOff then
            setToOriginalValues = true
            Humanoid.WalkSpeed = 0
            Humanoid.JumpPower = 0

            if not jerkoffTrack then
                local anim = Instance.new("Animation")
                anim.AnimationId = MAIN_ANIMATIONS.JERK_OFF
                jerkoffTrack = Humanoid:LoadAnimation(anim)
                jerkoffTrack.Looped = true
                jerkoffTrack:Play()
                jerkoffTrack:AdjustSpeed(currentSpeed)
            else
                jerkoffTrack:AdjustSpeed(currentSpeed)
            end

            if not closerhandsTrack then
                local anim = Instance.new("Animation")
                anim.AnimationId = MAIN_ANIMATIONS.CLOSER_HANDS
                closerhandsTrack = Humanoid:LoadAnimation(anim)
                closerhandsTrack:Play()
                closerhandsTrack:AdjustSpeed(currentSpeed)
            else
                closerhandsTrack:AdjustSpeed(currentSpeed)
            end
        elseif setToOriginalValues then
            setToOriginalValues = false
            Humanoid.WalkSpeed = 16
            Humanoid.JumpPower = 50
            if jerkoffTrack then jerkoffTrack:Stop(); jerkoffTrack = nil end
            if closerhandsTrack then closerhandsTrack:Stop(); closerhandsTrack = nil end
        end
    end))

    safeNotify({ Title = "Troll", Content = "Инструмент добавлен в инвентарь!", Duration = 3 })
end

TrollToolGroup:CreateButton({
    Name = "Get Animation Tool",
    Icon = NebulaIcons:GetIcon('sparkles', 'Lucide'),
    Callback = function()
        setupJerkTool()
    end
}, "BTN_GIVE_JERK")

-- Функции троллинга игроков
local function ragdollTarget(target)
    if not target or not target.Character then return end
    for _, v in ipairs(target.Character:GetDescendants()) do
        if v:IsA("JointInstance") then v:Destroy() end
    end
    safeNotify({ Title = "Troll", Content = target.Name .. " теперь тряпка!", Duration = 2 })
end

local function spinTarget(target)
    if not target or not target.Character then return end
    local hrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local bav = Instance.new("BodyAngularVelocity")
    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bav.AngularVelocity = Vector3.new(0, 99999, 0)
    bav.Parent = hrp
    safeNotify({ Title = "Troll", Content = target.Name .. " улетел в спин!", Duration = 2 })
    task.wait(3)
    if bav then bav:Destroy() end
end

local function tripTarget(target)
    if not target or not target.Character then return end
    local hum = target.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hum.HipHeight = -5
    safeNotify({ Title = "Troll", Content = target.Name .. " провалился!", Duration = 2 })
end

local function danceTarget(target)
    if not target or not target.Character then return end
    local hum = target.Character:FindFirstChildOfClass("Humanoid")
    local animate = target.Character:FindFirstChild("Animate")
    if not hum or not animate then return end

    local dance = animate:FindFirstChild("dance")  
    if dance then  
        local danceAnim = dance:FindFirstChildOfClass("Animation")  
        if danceAnim then  
            local track = hum:LoadAnimation(danceAnim)  
            track:Play()  
            safeNotify({ Title = "Troll", Content = target.Name .. " танцует!", Duration = 2 })  
        end  
    end
end

